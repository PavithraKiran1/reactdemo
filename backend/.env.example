## Server
PORT=3000
NODE_ENV=development

## Session (used to store OIDC state + nonce between /login and /callback)
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

## Redis (recommended for production session persistence)
## Example: redis://localhost:6379
REDIS_URL=

## Okta OIDC (PLACEHOLDERS - configure in Okta Admin)
OKTA_ISSUER=https://your-okta-domain.okta.com/oauth2/default
OKTA_CLIENT_ID=YOUR_OKTA_CLIENT_ID
OKTA_CLIENT_SECRET=YOUR_OKTA_CLIENT_SECRET
OKTA_REDIRECT_URI=http://localhost:3000/auth/okta/callback
OKTA_SCOPES=openid profile email groups

## Internal app JWT (minted by this BFF after Okta login)
APP_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
APP_JWT_EXPIRES_IN=15m

## One-time-code handoff (mobile deep-link -> exchange endpoint)
ONE_TIME_CODE_TTL_SECONDS=60

